# ===== PLIEGONAUT - Variables de Entorno =====
# Copia este archivo como .env y ajusta los valores

# --- API (Node.js/Express) ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
API_KEY=dev-key-change-in-production
WORKER_API_KEY=worker-dev-key-change
CRON_SCHEDULE=0 * * * *
SODA_API_URL=https://www.datos.gov.co/resource/p6dx-8zbt.json
SODA_API_TIMEOUT=120000
SECOP1_PROCESSES_URL=https://www.datos.gov.co/resource/f789-7hwg.json
SECOP_INTEGRADO_URL=https://www.datos.gov.co/resource/rpmr-utcd.json
SECOP2_CONTRACTS_URL=https://www.datos.gov.co/resource/jbjy-vk9h.json
# SOCRATA_APP_TOKEN=  # opcional, aumenta el rate limit de datos.gov.co (aplicado en ingest, /api/search y scanner legacy)

# --- Ingestión incremental SECOP II + SECOP I (Fase 1.1 + 1.2) ---
# INGEST_MAX_PAGES=10        # páginas máx por ejecución (10 * 1000 registros)
# INGEST_PAGE_SIZE=1000      # $limit por request (Socrata permite hasta 1000)
# INGEST_BOOTSTRAP_DAYS=7    # ventana inicial hacia atrás si no hay IngestLog
# INGEST_SECOP1_ENABLED=true   # ingesta SECOP I Procesos (f789-7hwg) para alcaldías
# INGEST_SECOP_INTEGRADO_ENABLED=true # ingesta SECOP Integrado (rpmr-utcd) solo Convocado (sin watermark de fecha)
# INGEST_CONTRACTS_ENABLED=true # enriquecimiento de adjudicaciones (jbjy-vk9h)

# --- Búsqueda manual (Fase 1.5) ---
# SEARCH_CACHE_TTL_MS=900000   # caché en memoria de /api/search (default 15 min)
# SEARCH_CACHE_MAX=200         # entradas máx antes de evictar la más antigua
# SEARCH_USE_DB=true           # sirve /api/search desde ContractMatch ingerido (DB enriquecida); fallback a SODA en vivo si no hay datos

# --- Monitoreo y alertas (Fase 1.6) ---
LOG_FILE=/tmp/pliegonaut-api.log   # destino de logs Pino (se crea si no existe)
# ALERT_WEBHOOK_URL=                # webhook HTTP (Slack/Teams/otros) tras 3 fallos consecutivos de ingestión

# --- VORTAL (Fase 2 - scraper tiempo real) ---
# SECOP_SOURCE=soda                 # fuente activa: soda | vortal_scrape | vortal_api
# VORTAL_BASE_URL=https://community.secop.gov.co
# TWOCAPTCHA_API_KEY=               # solver de ReCaptcha (2captcha, pago ~$2/1000). Sin él solo resolución manual.
# CHROME_PATH=                      # binario de Chromium para el scraper (si no se auto-detecta el de Playwright)
# MANUAL_SOLVE_TIMEOUT_MS=90000     # PoC: cuánto esperar a resolución humana del captcha (modo headful)
# --- Scraper VORTAL (Fase 2.1) ---
# VORTAL_SCRAPER_ENABLED=true       # arranca el cron de detección (requiere sesión bootstrapada)
# VORTAL_CRON_SCHEDULE=*/15 * * * * # frecuencia de detección de nuevos procesos
# VORTAL_HEADFUL=true               # bootstrap: abre navegador visible para resolver el captcha 1 vez
# VORTAL_USER_DATA_DIR=             # perfil de Chromium persistente (default storage/vortal/user_data)
# VORTAL_CHROME_PATH=               # binario de Chromium (si el auto-detecto falla)
# VORTAL_DOCS_DIR=                  # dónde guardar pliegos PDF (default storage/pliegos)

# --- Base de Datos ---
DATABASE_URL=postgresql://pliegonaut:pliegonaut@localhost:5432/pliegonaut?schema=public

# --- Worker Python ---
WORKER_ROOT=./apps/worker-python
PYTHON_EXEC=/path/to/your/python3
BACKEND_URL=http://localhost:3001
MAX_OCR_PAGES=50
POLL_INTERVAL=60

# --- LLM ---
# Opciones: ollama (local) o gemini (API)
LLM_PROVIDER=ollama
# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
# Gemini (solo si LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.0-flash

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_KEY=dev-key-change-in-production
NEXTAUTH_SECRET=pliegonaut-dev-secret-change-in-production-123
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_ADMIN_EMAIL=admin@pliegonaut.com
NEXTAUTH_ADMIN_PASSWORD=change-this-password
