# ===== PLIEGONAUT - Variables de Entorno =====
# Copia este archivo como .env y ajusta los valores

# --- API (Node.js/Express) ---
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
API_KEY=dev-key-change-in-production
WORKER_API_KEY=worker-dev-key-change
CRON_SCHEDULE=0 * * * *
SODA_API_URL=https://www.datos.gov.co/resource/p6dx-8zbt.json
SODA_API_TIMEOUT=30000

# --- Base de Datos ---
DATABASE_URL=postgresql://pliegonaut:pliegonaut@localhost:5432/pliegonaut?schema=public

# --- Worker Python ---
WORKER_ROOT=./apps/worker-python
PYTHON_EXEC=/home/dark-dvn/miniforge3/envs/agente_ia/bin/python3
BACKEND_URL=http://localhost:3001
MAX_OCR_PAGES=50
POLL_INTERVAL=60

# --- LLM ---
# Opciones: ollama (local) o gemini (API)
LLM_PROVIDER=ollama
# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
# Gemini (solo si LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-2.0-flash

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
